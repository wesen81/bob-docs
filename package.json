{
  "name": "bob-docs",
  "private": false,
  "version": "1.0.0",
  "description": "A React-based documentation viewer for browsing and viewing markdown, JSON, CSV, and mermaid diagram files",
  "type": "module",
  "main": "dist/index.html",
  "bin": {
    "bob-docs": "./bin/cli.js"
  },
  "files": [
    "dist",
    "bin",
    ".bob-docs.json.example",
    "README.md"
  ],
  "keywords": [
    "documentation",
    "docs",
    "viewer",
    "markdown",
    "mermaid",
    "json",
    "csv",
    "static-site",
    "documentation-viewer"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wesen81/bob-docs.git"
  },
  "author": "Nagy Viktor <viktor.nagy@d8t.hu>",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "bun run generate-manifest && tsc -b && vite build",
    "build:preview": "bun run build && bun run copy-docs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "generate-manifest": "bun run scripts/generate-manifest.ts",
    "copy-docs": "bun run scripts/copy-docs.ts",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "mermaid": "^11.12.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/hast": "^3.0.4",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5"
  }
}
